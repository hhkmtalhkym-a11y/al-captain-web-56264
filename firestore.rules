rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS (دوال التحقق والصلاحيات)
    // ==========================================

    // التحقق من تسجيل دخول المستخدم
    function isSignedIn() {
      return request.auth != null;
    }

    // التحقق مما إذا كان المستخدم هو صاحب السجل
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // التحقق من صلاحيات الإدارة العليا (المدير العام)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'admin-0945688090' ||
        request.auth.token.email == 'family2016amer@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // التحقق من رتبة المعلن أو منظم الدوري
    function isLeagueManager() {
      return isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'league_manager'
      );
    }

    // ==========================================
    // 1. USERS COLLECTION (بيانات المستخدمين)
    // ==========================================
    match /users/{userId} {
      // قراءة البيانات: فقط المستخدم نفسه أو المدير العام
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      
      // إنشاء حساب جديد: المستخدم لنفسه أو المدير
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      
      // تعديل الحساب: المستخدم لنفسه (دون تغيير رتبة الإدارة إلا للمدير) أو المدير
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'role', 'isBanned'])))
      );
      
      // الحذف: فقط المستخدم لحسابه أو المدير العام
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // ==========================================
    // 2. PLAYGROUNDS (الملاعب)
    // ==========================================
    match /playgrounds/{playgroundId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ==========================================
    // 3. BOOKINGS (الحجوزات)
    // ==========================================
    match /bookings/{bookingId} {
      allow read, create, update, delete: if true;
    }

    // ==========================================
    // 4. LEAGUES & TOURNAMENTS (الدوريات والبطولات)
    // ==========================================
    match /leagues/{leagueId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ==========================================
    // 5. LEAGUE MATCHES (مباريات وجداول الدوريات)
    // ==========================================
    match /leagueMatches/{matchId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ==========================================
    // 6. ACADEMIES (الأكاديميات الرياضية)
    // ==========================================
    match /academies/{academyId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ==========================================
    // 7. ACADEMY REGISTRATIONS (تسجيلات الأكاديميات)
    // ==========================================
    match /academyRegistrations/{regId} {
      allow read, create, update, delete: if true;
    }

    // ==========================================
    // 8. FRIENDLY MATCHES & CHALLENGES (الوديات والتحديات)
    // ==========================================
    match /friendlyMatches/{matchId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    match /friendly_matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ==========================================
    // 9. PLAYER CARDS & SCOUTING (بطاقات اللاعبين وكشاف المواهب)
    // ==========================================
    match /playerCards/{cardId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    match /player_cards/{cardId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ==========================================
    // 9.1 OPPONENT RATINGS & CREDIBILITY (تقييمات الخصم والروح الرياضية)
    // ==========================================
    match /match_ratings/{ratingId} {
      // قراءة التقييمات متاحة للجميع لتعزيز الشفافية والمصداقية
      allow read: if true;

      // إنشاء تقييم جديد مع التحقق من صحة المعايير (1 - 5 نجوم)
      allow create: if request.resource.data.overallRating >= 1 
                    && request.resource.data.overallRating <= 5
                    && request.resource.data.sportsmanshipRating >= 1 
                    && request.resource.data.sportsmanshipRating <= 5
                    && request.resource.data.targetPlayerName is string
                    && request.resource.data.reviewerName is string;

      // التعديل متاح للإدارة أو صاحب التقييم
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.reviewerId);

      // الحذف متاح للمدير العام فقط لحماية مصداقية سجلات اللاعبين من التلاعب
      allow delete: if isAdmin();
    }

    match /matchRatings/{ratingId} {
      allow read: if true;
      allow create: if request.resource.data.overallRating >= 1 
                    && request.resource.data.overallRating <= 5;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.reviewerId);
      allow delete: if isAdmin();
    }

    match /opponent_ratings/{ratingId} {
      allow read: if true;
      allow create: if request.resource.data.overallRating >= 1 
                    && request.resource.data.overallRating <= 5;
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.reviewerId);
    }

    // ==========================================
    // 10. NOTIFICATIONS (الإشعارات)
    // ==========================================
    match /notifications/{notifId} {
      allow read, create, update, delete: if true;
    }

    // ==========================================
    // 11. ADMIN REQUESTS (طلبات الإدارة والترقيات)
    // ==========================================
    match /adminRequests/{requestId} {
      allow read, create, update, delete: if true;
    }

    // ==========================================
    // 12. ACTIVITY LOGS (سجل التدقيق والنشاطات)
    // ==========================================
    match /activityLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // ==========================================
    // 13. DELETED RECORDS REGISTRY (سجل المحذوفات الدائم)
    // ==========================================
    match /deletedRecords/{recordId} {
      allow read, write: if true;
    }

  }
}
